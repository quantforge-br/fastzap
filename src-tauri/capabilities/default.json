{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Local FastZap UI",
  "webviews": [
    "ui",
    "panel"
  ],
  "permissions": [
    "core:default",
    "core:window:allow-start-dragging",
    "core:window:allow-start-resize-dragging",
    "core:window:allow-minimize",
    "core:window:allow-toggle-maximize",
    "core:window:allow-close",
    "opener:default",
    "allow-settings-get",
    "allow-settings-patch",
    "allow-accounts-list",
    "allow-accounts-create",
    "allow-accounts-update",
    "allow-accounts-delete",
    "allow-accounts-reorder",
    "allow-user-agent-presets",
    "allow-layout-get",
    "allow-layout-set-bounds",
    "allow-layout-set-overlay",
    "allow-account-activate",
    "allow-app-action",
    "allow-app-close-confirmed",
    "allow-app-desktop",
    "allow-unread-get",
    "allow-account-sync-photo",
    "allow-calling-codes",
    "allow-open-chat-by-number",
    "allow-app-locale",
    "allow-app-info",
    "allow-panel-supports-positioning",
    "allow-proxy-password-set",
    "allow-proxy-password-present",
    "allow-settings-reset",
    "allow-dialog-pick-folder",
    "allow-dialog-pick-files",
    "allow-open-path",
    "allow-reveal-path",
    "allow-downloads-default-dir"
  ]
}
