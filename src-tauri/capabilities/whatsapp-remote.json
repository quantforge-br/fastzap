{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "whatsapp-remote",
  "description": "Bridge commands callable from WhatsApp Web account webviews",
  "webviews": [
    "wa-*"
  ],
  "remote": {
    "urls": [
      "https://web.whatsapp.com/*"
    ]
  },
  "permissions": [
    "allow-wa-title-changed",
    "allow-wa-shortcut",
    "allow-wa-theme-event",
    "allow-wa-open-account-selector",
    "allow-wa-profile-photo"
  ]
}
