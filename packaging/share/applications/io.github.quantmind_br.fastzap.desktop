[Desktop Entry]
Version=1.0
Type=Application
Name=FastZap
Comment=Multi-account WhatsApp desktop client
Comment[pt_BR]=Cliente de desktop do WhatsApp com várias contas
Exec=fastzap %u
Icon=io.github.quantmind_br.fastzap
Terminal=false
Categories=Chat;Network;InstantMessaging;GTK;
Keywords=WhatsApp;Chat;FastZap;Evolution;
StartupWMClass=fastzap
MimeType=x-scheme-handler/whatsapp;x-scheme-handler/fastzap;
SingleMainWindow=true
X-GNOME-UsesNotifications=true
